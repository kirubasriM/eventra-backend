# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/eventra_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
PORT=8080

# SMS & Mobile OTP Configuration
# Set OTP_SMS_ENABLED=true for production real-time SMS delivery
# Set OTP_SMS_ENABLED=false for local development testing mode
OTP_SMS_ENABLED=false
SMS_PROVIDER=msg91
SMS_API_KEY=your_msg91_auth_key_here
SMS_SENDER_ID=your_sender_id_here
SMS_TEMPLATE_ID=your_msg91_flow_template_id_here
SMS_PROVIDER_URL=https://control.msg91.com/api/v5/flow/
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Email OTP Configuration
# Set EMAIL_ENABLED=true for real email delivery in production
# Set EMAIL_ENABLED=false for local development testing mode
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=no-reply@eventra.in
# Optional HTTP email provider (e.g. resend, sendgrid, brevo, or generic)
# EMAIL_PROVIDER=resend
# EMAIL_PASSWORD=your_resend_api_key
# EMAIL_API_URL=https://api.resend.com/emails
